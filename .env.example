# --- LLM ---
OPENROUTER_API_KEY=your_api_key_here
# OPENAI_API_KEY=                 # alternative: used only if OPENROUTER_API_KEY is empty
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# cheap: router, specialists (Finance/Web/Coder), document summaries
LLM_MODEL_ID=openai/gpt-4o-mini
# expensive: ONLY ComplexTeam (empty = LLM_MODEL_ID)
LLM_STRONG_MODEL_ID=openai/gpt-4o

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=123456789
# Telegram ids allowed to install/remove skills from chat; empty = commands disabled
ADMIN_USER_IDS=

# --- REST API (optional): "token:user_id", comma-separated.
# Use your Telegram id as user_id to share memory across channels.
# Generate long tokens: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKENS=
# API_BIND=0.0.0.0   (compose variable: exposes the port outside localhost)
# CLI: user id (as above to share memory; with your Telegram id, scheduled tasks
# also become a single list and the outcome of tasks created from the CLI arrives on Telegram)
CLI_USER_ID=cli

# --- Email via AgentMail (optional): enabled only with the key AND email.inbox_id in config.yaml ---
AGENTMAIL_API_KEY=
# Allowed senders: "address[:user_id]" comma-separated. Empty = no senders (fail-closed).
# With :user_id the email shares memory and profile with that user (e.g. your Telegram id).
# Example: EMAIL_ALLOWED_SENDERS=io@pippo.com:123456789
EMAIL_ALLOWED_SENDERS=

# --- Web search: Brave Search API (optional, tried first; without a key it is skipped) ---
BRAVE_API_KEY=

# --- Variables not read by PicoBot ---
# AGNO_TELEMETRY=false             # PicoBot default: no usage data sent to Agno
# KEENABLE_API_KEY=                # optional, read by Agno: without a key Keenable search uses the public endpoint (lower limits)
# stt container variables (read by compose):
# STT_MODEL=small, STT_BEAM_SIZE=1, STT_THREADS=4, STT_LANGUAGES=it,en

# --- Everything else: config/config.yaml (see config/config_example.yaml) ---

# --- Secrets used as ${NAME} in mcp_config.json and config.yaml ---
# In the MCP servers JSON (or in config.yaml) you write ${NAME}; the value lives here (e.g. "X-API-Key": "${LLMBASE_API_KEY}")
# LLMBASE_API_KEY=
# CONTEXT7_API_KEY=
