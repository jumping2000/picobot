# --- LLM ---
OPENROUTER_API_KEY=la_tua_api_key_qui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# economico: router, specialisti (Finance/Web/Coder), riassunti documenti
LLM_MODEL_ID=openai/gpt-4o-mini
# costoso: SOLO ComplexTeam (vuoto = LLM_MODEL_ID)
LLM_STRONG_MODEL_ID=openai/gpt-4o

# --- Telegram (opzionale) ---
TELEGRAM_BOT_TOKEN=il_tuo_telegram_bot_token_qui
TELEGRAM_ALLOWED_USER_IDS=123456789
# id Telegram che possono installare/rimuovere skill da chat; vuoto = comandi spenti
ADMIN_USER_IDS=

# --- API REST (opzionale): "token:user_id", separati da virgola.
# Usa come user_id il tuo id Telegram per condividere la memoria tra i canali.
# Genera token lunghi: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKENS=
# API_BIND=0.0.0.0   (variabile del compose: pubblica la porta fuori da localhost)
# CLI: id utente (come sopra per condividere la memoria; con il tuo id Telegram anche i task programmati
# sono un elenco unico e l'esito dei task creati dalla CLI arriva su Telegram)
CLI_USER_ID=cli

# --- Variabili non lette da PicoBot ---
# AGNO_TELEMETRY=false             # default di PicoBot: nessun dato di utilizzo inviato ad Agno
# Variabili del container stt (lette dal compose): STT_MODEL=small, STT_BEAM_SIZE=1, STT_THREADS=4, STT_LANGUAGES=it,en

# --- Tutto il resto: config/config.yaml (vedi config/config_example.yaml) ---

# --- Segreti usati come ${NOME} in mcp_config.json e config.yaml ---
# Nel JSON dei server MCP (o in config.yaml) si scrive ${NOME}; il valore sta qui (es. "X-API-Key": "${LLMBASE_API_KEY}")
# LLMBASE_API_KEY=
