# --- LLM ---
OPENROUTER_API_KEY=la_tua_api_key_qui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# economico: router, specialisti (Finance/Web/Coder), riassunti documenti
LLM_MODEL_ID=openai/gpt-4o-mini
# costoso: SOLO ComplexTeam (vuoto = LLM_MODEL_ID)
LLM_STRONG_MODEL_ID=openai/gpt-4o

# --- Telegram (opzionale) ---
TELEGRAM_BOT_TOKEN=il_tuo_telegram_bot_token_qui
TELEGRAM_ALLOWED_USER_IDS=123456789
# id Telegram che possono installare/rimuovere skill da chat; vuoto = comandi spenti
ADMIN_USER_IDS=

# --- API REST (opzionale): "token:user_id", separati da virgola.
# Usa come user_id il tuo id Telegram per condividere la memoria tra i canali.
# Genera token lunghi: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKENS=
# HTTPS diretto (senza reverse proxy). Senza TLS il token viaggia in chiaro se esponi l'API.
# Cert di prova: openssl req -x509 -newkey rsa:2048 -nodes -keyout certs/key.pem -out certs/cert.pem -days 365 -subj "/CN=host"
# API_SSL_CERTFILE=/app/certs/cert.pem
# API_SSL_KEYFILE=/app/certs/key.pem
# API_BIND=0.0.0.0   (variabile del compose: pubblica la porta fuori da localhost)
# CLI: id utente (come sopra per condividere la memoria; con il tuo id Telegram anche i task programmati
# sono un elenco unico e l'esito dei task creati dalla CLI arriva su Telegram)
CLI_USER_ID=cli

# --- Opzionali (default) ---
# AGNO_TELEMETRY=false             # default di PicoBot: nessun dato di utilizzo inviato ad Agno
# TIMEZONE=Europe/Rome
# HISTORY_RUNS=6
# ENABLE_MEMORY=true
# ENABLE_LEARNING=true
# ENABLE_SESSION_SUMMARIES=false   # +1 chiamata LLM per run
# ENABLE_CRITIC=true
# REGION=it-it                     # regione dei risultati della ricerca web (es. us-en)
# SCHEDULE_MIN_INTERVAL_MIN=30
# MAX_SCHEDULES_PER_USER=10
# MAX_UPLOAD_MB=15
# CODE_TIMEOUT_S=30
# DOC_CHUNK_CHARS=100000           # sotto questa soglia il riassunto e' 1 sola chiamata
# TRACE_ENABLED=false              # traccia ogni richiesta in data/trace.jsonl; /trace mostra l'ultima
# TRACE_MAX_MB=5

# --- Messaggi vocali Telegram (opzionale) ---
# Servizio di trascrizione del profilo compose "stt": mkdir -p models && sudo chown -R 1000 models,
# poi docker compose --profile stt up -d --build. Vuoto = vocali spenti.
# STT_URL=http://stt:8000
# STT_TIMEOUT_S=180
# MAX_VOICE_S=300                   # durata massima di un vocale (secondi)
# Variabili del container stt (lette dal compose): STT_MODEL=small, STT_BEAM_SIZE=1, STT_THREADS=4, STT_LANGUAGES=it,en

# --- Skill (ComplexTeam) ---
# ENABLE_SKILLS=true
# SKILLS_DIR=/app/skills            # nel container; sull'host la CLI usa ./skills
# SKILLS_LIST_MAX=50
# SKILLS_ROUTER_HINT_MAX=15

# --- Esecuzione codice e file in uscita ---
# CODE_NODE_MEM_MB=1536             # pptxgenjs va in abort sotto 1 GB
# CODE_MAX_RUNS=6                   # esecuzioni approvate per richiesta
# MAX_OUTPUT_MB=20
# MAX_OUTPUT_FILES=5
# OUTPUT_EXTENSIONS=docx,pptx,xlsx,csv,txt,md,pdf,html,json,py
# OUTBOX_TTL_H=24                   # file scaricabili via API per 24 ore

# --- MCP SECRETS ---
# Nel JSON dei server MCP si scrive ${NOME}; il valore sta qui (es. "X-API-Key": "${LLMBASE_API_KEY}")
# LLMBASE_API_KEY=
