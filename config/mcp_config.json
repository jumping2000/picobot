{
	"mcpServers": {
    	"filesystem": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-filesystem", "/app/workspace"]
			},
		"llmbase": {
			"type": "streamableHttp",
			"url": "http://192.168.1.214:5555/mcp/",
			"headers": {
				"X-API-Key": "${LLMBASE_API_KEY}"
				},
			"timeout_seconds": 30
			},
		"curvo": {
			"type": "streamableHttp",
			"url": "https://curvo.eu/backtest/mcp",
			"timeout_seconds": 30
			}	
	},
	"inputs": []
}
