.env
# blind mount
workspace/*
!workspace/.gitkeep
data/*
!data/.gitkeep
certs/*
!certs/.gitkeep
models/*
!models/.gitkeep
skills/*
!skills/.gitkeep
config/mcp_config.json
.venv/
__pycache__/
*.db
*.pkl
.superpowers/
docs/superpowers/
*.egg-info/
src/*.egg-info/
# lockfile di uv (non versionati), tranne quello dell'immagine stt
uv.lock
!stt/uv.lock
